# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pauli_effect"

# Anthropic AI
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# CopilotKit (Pauli Agent UI)
COPILOTKIT_API_KEY="your-copilotkit-key-here"

# Notion Integration (use both variable names for compatibility)
NOTION_API_TOKEN="secret_your-notion-token-here"
NOTION_API_KEY="secret_your-notion-token-here"
NOTION_DATABASE_ID="your-database-id-here"
NOTION_DATABASE_PROJECTS="your-database-id-here"

# AGI Open (Computer Use)
AGI_OPEN_API_KEY="your-agi-open-key-here"
AGI_OPEN_ENDPOINT="https://api.agiopen.org/v1"

# Server Configuration
PORT=3001
NODE_ENV="development"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# ByteRover Sync (Optional)
GITHUB_TOKEN="ghp_your-github-token-here"
GOOGLE_CLOUD_CREDENTIALS="path/to/credentials.json"

# Deployment (Production)
RAILWAY_ENVIRONMENT="production"
VERCEL_ENV="production"
