# ===========================================
# PAULI SYSTEM ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)
# ===========================================

# ===== COOLIFY DEPLOYMENT =====
COOLIFY_URL=http://31.220.58.212:8000
COOLIFY_API_TOKEN=your-coolify-api-token
COOLIFY_SERVICE_ID=your-service-id

# ===== GITHUB =====
GITHUB_TOKEN=ghp_your_github_token
GITHUB_ORG=executiveusa

# ===== NOTION SYNC =====
NOTION_API_KEY=secret_your_notion_key
NOTION_WORKSPACE_ID=your-workspace-id
NOTION_DATABASE_PROJECTS=your-projects-db-id
NOTION_DATABASE_TASKS=your-tasks-db-id

# ===== AI PROVIDERS =====
ANTHROPIC_API_KEY=sk-ant-api03-your-key
OPENAI_API_KEY=sk-proj-your-key
GOOGLE_API_KEY=AIzaSy-your-key
COPILOTKIT_API_KEY=your_copilotkit_api_key_here

# ===== DATABASE (Supabase) =====
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== STRIPE PAYMENTS =====
STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_SECRET_KEY=sk_test_your-key

# ===== GOOGLE CLOUD (Phase 2) =====
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_BUCKET=gs://pauli-second-brain-storage/
GOOGLE_CLOUD_CREDENTIALS=/path/to/service-account.json

# ===== APPLICATION SETTINGS =====
NODE_ENV=production
PORT=3001
VITE_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# ===== BYTEROVER SYNC =====
BYTEROVER_CONFIG=./00_SYSTEM/BYTEROVER_CONFIG.yml
BYTEROVER_SYNC_INTERVAL=15

# ===== VAPI VOICE (Future) =====
VAPI_API_KEY=your-vapi-key
VAPI_ASSISTANT_ID=your-assistant-id

# ===== AGI OPEN CONFIGURATION =====
AGI_OPEN_API_KEY=your_agi_open_api_key_here
AGI_OPEN_ENDPOINT=https://www.agiopen.org/api

# ===== LIBRECHAT CONFIGURATION =====
LIBRECHAT_ENABLED=true
LIBRECHAT_AUTH_SECRET=your_librechat_auth_secret_here
LIBRECHAT_TEAM_EMAILS=team@example.com,admin@example.com
