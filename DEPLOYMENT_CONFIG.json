{
  "deployment": {
    "frontend": {
      "platform": "Vercel",
      "configuration": {
        "framework": "Vite (React)",
        "node_version": "18.x",
        "build_command": "npm run build",
        "output_directory": "dist",
        "environment_variables": {
          "VITE_API_URL": "https://api.youromain.com",
          "NEXT_PUBLIC_SUPABASE_URL": "https://your-supabase-url.com",
          "NEXT_PUBLIC_SUPABASE_ANON_KEY": "${SUPABASE_ANON_KEY}"
        },
        "preview_deployment": true,
        "auto_deploy_on_merge": true,
        "regions": ["Global CDN"]
      },
      "deployment_steps": [
        "Connect GitHub repository to Vercel",
        "Set environment variables in Vercel dashboard",
        "Vercel automatically builds on push to main",
        "Built files served from global CDN",
        "SSL certificate auto-renewed"
      ],
      "monitoring": {
        "uptime_check": "https://your-domain.com/api/health",
        "frequency": "every 5 minutes",
        "alert_threshold": "3 consecutive failures"
      }
    },
    "backend": {
      "platform": "Self-hosted (Hostinger via Coolify)",
      "configuration": {
        "runtime": "Node.js 18+",
        "package_manager": "npm",
        "port": 3001,
        "environment_file": ".env",
        "database": "PostgreSQL (self-hosted or Supabase)",
        "cache": "Redis",
        "job_queue": "BullMQ + Redis"
      },
      "docker_configuration": {
        "dockerfile_location": "Dockerfile",
        "dockerfile_content": {
          "base_image": "node:18-alpine",
          "working_directory": "/app",
          "copy_files": [
            "package*.json ./",
            "prisma ./prisma/",
            "src ./src/",
            "server ./server/"
          ],
          "build_steps": [
            "npm ci --only=production",
            "npx prisma generate",
            "npx tsc --project tsconfig.app.json"
          ],
          "expose_port": 3001,
          "health_check": {
            "command": "curl -f http://localhost:3001/api/health || exit 1",
            "interval": "30s",
            "timeout": "10s",
            "retries": 3
          },
          "start_command": "npm start"
        }
      },
      "environment_variables": {
        "NODE_ENV": "production",
        "PORT": 3001,
        "DATABASE_URL": "${SUPABASE_DATABASE_URL}",
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_KEY": "${SUPABASE_KEY}",
        "TWILIO_ACCOUNT_SID": "${TWILIO_ACCOUNT_SID}",
        "TWILIO_AUTH_TOKEN": "${TWILIO_AUTH_TOKEN}",
        "TWILIO_PHONE_NUMBER": "${TWILIO_PHONE_NUMBER}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "JWT_SECRET": "${JWT_SECRET}",
        "REDIS_URL": "${REDIS_URL}",
        "CORS_ORIGIN": "https://your-domain.com"
      }
    },
    "database": {
      "platform": "Self-hosted PostgreSQL",
      "container_platform": "Hostinger via Coolify",
      "configuration": {
        "version": "15",
        "port": 5432,
        "database_name": "pauli_db",
        "username": "pauli_user",
        "environment_variables": {
          "POSTGRES_PASSWORD": "${DB_PASSWORD}",
          "POSTGRES_USER": "pauli_user",
          "POSTGRES_DB": "pauli_db"
        }
      },
      "extensions": [
        {
          "name": "uuid-ossp",
          "reason": "Generate UUID for primary keys"
        },
        {
          "name": "pgvector",
          "reason": "Vector search for embeddings",
          "installation": "CREATE EXTENSION IF NOT EXISTS vector"
        },
        {
          "name": "pg_trgm",
          "reason": "Full-text search optimization",
          "installation": "CREATE EXTENSION IF NOT EXISTS pg_trgm"
        }
      ],
      "backup_strategy": {
        "frequency": "Daily at 2 AM UTC",
        "retention": "30 days",
        "method": "pg_dump to S3 or local storage",
        "backup_script": "scripts/backup-db.sh"
      },
      "performance_tuning": {
        "connection_pooling": "PgBouncer (connection pool)",
        "max_connections": 100,
        "shared_buffers": "256MB",
        "effective_cache_size": "1GB",
        "work_mem": "4MB"
      },
      "monitoring": {
        "disk_usage": "Alert > 80%",
        "connection_count": "Alert > 90 of 100",
        "slow_queries": "Log queries > 1s"
      }
    },
    "redis": {
      "platform": "Self-hosted (Docker via Coolify)",
      "configuration": {
        "version": "7",
        "port": 6379,
        "memory_policy": "allkeys-lru",
        "max_memory": "512MB"
      },
      "purpose": "Job queue (BullMQ) + caching"
    },
    "coolify_setup": {
      "platform": "Hostinger VPS",
      "installation": "curl -fsSL https://get.coollabs.io/docker/install.sh | sh",
      "projects": [
        {
          "name": "pauli-backend",
          "type": "Docker",
          "source": "GitHub",
          "build_pack": "Node.js",
          "port": 3001,
          "volume_mounts": [
            "/data/db-backups:/app/backups",
            "/data/logs:/app/logs"
          ]
        },
        {
          "name": "pauli-database",
          "type": "Docker",
          "image": "postgres:15",
          "port": 5432,
          "volume_mounts": [
            "/data/postgres:/var/lib/postgresql/data"
          ]
        },
        {
          "name": "pauli-redis",
          "type": "Docker",
          "image": "redis:7",
          "port": 6379,
          "volume_mounts": [
            "/data/redis:/data"
          ]
        }
      ],
      "networking": {
        "internal_network": "pauli-network",
        "backend_hostname": "pauli-backend",
        "database_hostname": "pauli-database",
        "redis_hostname": "pauli-redis"
      },
      "ssl_certificate": {
        "provider": "Let's Encrypt",
        "auto_renewal": true,
        "domains": [
          "api.your-domain.com",
          "yourdomain.com"
        ]
      }
    },
    "dns_configuration": {
      "records": [
        {
          "type": "A",
          "name": "api",
          "value": "your-hostinger-ip-address",
          "ttl": 3600
        },
        {
          "type": "CNAME",
          "name": "www",
          "value": "your-domain.vercel.app",
          "ttl": 3600
        },
        {
          "type": "MX",
          "priority": 10,
          "value": "mail.your-domain.com",
          "ttl": 3600
        }
      ]
    },
    "ci_cd_pipeline": {
      "platform": "GitHub Actions",
      "workflow_file": ".github/workflows/deploy.yml",
      "triggers": [
        {
          "event": "push to main",
          "action": "Deploy to production"
        },
        {
          "event": "pull request",
          "action": "Run tests, build, deploy to staging"
        }
      ],
      "stages": [
        {
          "name": "Test",
          "steps": [
            "npm install",
            "npm run lint",
            "npm run test",
            "npm run build"
          ]
        },
        {
          "name": "Build Docker Image",
          "steps": [
            "docker build -t pauli-backend:${GITHUB_SHA} .",
            "docker tag pauli-backend:${GITHUB_SHA} pauli-backend:latest"
          ]
        },
        {
          "name": "Push to Registry",
          "steps": [
            "docker push to registry (Docker Hub or private)"
          ]
        },
        {
          "name": "Deploy Frontend",
          "steps": [
            "Vercel auto-deploys on push"
          ]
        },
        {
          "name": "Deploy Backend",
          "steps": [
            "SSH to Hostinger",
            "cd /app/pauli",
            "git pull origin main",
            "npm install",
            "npx prisma migrate deploy",
            "npm run build",
            "pm2 restart pauli-backend || pm2 start npm --name pauli-backend -- start"
          ]
        },
        {
          "name": "Health Check",
          "steps": [
            "curl https://api.your-domain.com/api/health",
            "Verify response is 200 OK"
          ]
        }
      ]
    },
    "process_management": {
      "tool": "PM2",
      "ecosystem_file": "ecosystem.config.js",
      "processes": [
        {
          "name": "pauli-backend",
          "script": "./dist/index.js",
          "instances": 2,
          "exec_mode": "cluster",
          "env": {
            "NODE_ENV": "production"
          },
          "error_file": "logs/pauli-backend.err.log",
          "out_file": "logs/pauli-backend.out.log",
          "merge_logs": true
        }
      ],
      "startup_script": "pm2 startup && pm2 save"
    },
    "logging_and_monitoring": {
      "logging": {
        "format": "JSON",
        "level": "info",
        "storage": "/data/logs",
        "rotation": "Daily, keep 30 days",
        "provider": "Winston or Pino"
      },
      "error_tracking": {
        "provider": "Sentry or similar",
        "dsn": "${SENTRY_DSN}",
        "environment": "production",
        "sample_rate": 1.0
      },
      "performance_monitoring": {
        "provider": "New Relic or Datadog",
        "api_key": "${MONITORING_API_KEY}",
        "track": [
          "API response times",
          "Database query times",
          "Agent execution times",
          "Error rates"
        ]
      },
      "uptime_monitoring": {
        "provider": "Uptime Robot or similar",
        "check_url": "https://api.your-domain.com/api/health",
        "frequency": "5 minutes",
        "alert_email": "alerts@your-domain.com"
      }
    },
    "backup_and_disaster_recovery": {
      "database_backups": {
        "frequency": "Daily at 2 AM UTC",
        "retention": "30 days",
        "method": "pg_dump + S3",
        "restore_test": "Monthly"
      },
      "file_backups": {
        "critical_files": [
          ".env (encrypted)",
          "ecosystem.config.js",
          "custom scripts"
        ],
        "frequency": "Daily",
        "retention": "30 days"
      },
      "disaster_recovery_plan": {
        "rto": "1 hour",
        "rpo": "15 minutes",
        "steps": [
          "Restore database from backup",
          "Restore .env file",
          "Rebuild Docker images",
          "Restart services via Coolify",
          "Verify health checks pass"
        ]
      }
    },
    "security": {
      "secrets_management": {
        "method": "GitHub Secrets for CI/CD",
        "variables": [
          "DATABASE_URL",
          "SUPABASE_URL",
          "SUPABASE_KEY",
          "TWILIO_ACCOUNT_SID",
          "TWILIO_AUTH_TOKEN",
          "OPENAI_API_KEY",
          "JWT_SECRET"
        ],
        "rotation": "Every 90 days"
      },
      "network_security": {
        "firewall": "UFW (Linux)",
        "rules": [
          "Allow: 22 (SSH) from trusted IPs only",
          "Allow: 80 (HTTP) from all",
          "Allow: 443 (HTTPS) from all",
          "Allow: 5432 (PostgreSQL) from backend only",
          "Allow: 6379 (Redis) from backend only",
          "Deny: All else"
        ],
        "ssl_tls": "Let's Encrypt, auto-renewal"
      },
      "api_security": {
        "authentication": "JWT",
        "rate_limiting": "100 requests/minute per IP",
        "cors": "Restrict to https://your-domain.com",
        "helmet": "Use helmet middleware"
      },
      "audit_logging": {
        "log": "All API calls with request/response",
        "retention": "90 days",
        "sensitive_fields": "Mask in logs"
      }
    },
    "performance_optimization": {
      "frontend": {
        "cdn": "Vercel global CDN",
        "caching": "Browser cache 1 year for static assets",
        "compression": "Gzip/Brotli enabled"
      },
      "backend": {
        "response_caching": "Redis for frequent queries",
        "database_indexes": [
          "contacts(user_id)",
          "contacts(email)",
          "tasks(user_id, status)",
          "embeddings(user_id)"
        ],
        "connection_pooling": "PgBouncer 20 connections"
      }
    },
    "scaling_strategy": {
      "frontend": "Vercel handles auto-scaling",
      "backend": {
        "current": "Single instance (2 vCPU, 2GB RAM)",
        "horizontal_scaling": "Add Coolify services as needed",
        "load_balancing": "Nginx reverse proxy (manual setup)"
      },
      "database": {
        "current": "Single PostgreSQL instance (SSD)",
        "scaling": "Upgrade instance size if needed",
        "monitoring": "Alert at 80% disk/CPU"
      }
    }
  },
  "deployment_checklist": {
    "pre_deployment": [
      "[ ] All tests passing",
      "[ ] Zero TypeScript errors",
      "[ ] Security audit clean",
      "[ ] Environment variables set",
      "[ ] Database backups tested",
      "[ ] SSL certificate ready"
    ],
    "deployment": [
      "[ ] Push to main branch",
      "[ ] GitHub Actions pipeline runs",
      "[ ] Frontend builds and deploys to Vercel",
      "[ ] Backend Docker image built",
      "[ ] Database migrations applied",
      "[ ] Environment variables loaded",
      "[ ] Services start successfully"
    ],
    "post_deployment": [
      "[ ] Health checks pass",
      "[ ] Frontend accessible",
      "[ ] API responding",
      "[ ] Database connected",
      "[ ] All endpoints working",
      "[ ] Performance acceptable",
      "[ ] Logging active",
      "[ ] Monitoring alerts configured",
      "[ ] Team notified"
    ]
  },
  "cost_estimation": {
    "hostinger_vps": {
      "plan": "Premium (2 vCPU, 2GB RAM, 50GB SSD)",
      "cost_per_month": 20
    },
    "vercel": {
      "plan": "Pro (50GB bandwidth)",
      "cost_per_month": 20
    },
    "supabase_self_hosted": {
      "cost": "Included in Hostinger",
      "cost_per_month": 0
    },
    "twilio": {
      "whatsapp": "$0.005 per message",
      "voice": "$0.012 per minute",
      "estimate": 50
    },
    "openai_embeddings": {
      "cost_per_1k_tokens": "$0.02",
      "estimate": 50
    },
    "total_monthly": 140,
    "note": "Estimates based on moderate usage. Scale as needed."
  }
}
